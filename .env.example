# Copy to backend/.env and fill in. NEVER commit real keys.
DATABASE_URL=sqlite:///./strategic_memory_lab.db
CORS_ORIGINS=http://localhost:5173

# Hindsight (https://ui.hindsight.vectorize.io for Cloud, or self-hosted URL)
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
HINDSIGHT_API_KEY=
HINDSIGHT_BANK_ID=strategic-memory-lab-clouddesk

# LLM provider (Groq). Leave empty to run in clearly-labelled rule-based mode.
GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
LLM_FALLBACK_MODEL=qwen/qwen3-32b
